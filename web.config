<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  FileStation v5.7.5 - IIS 보안 설정 (web.config)
  ============================================================
  이 파일을 FileStation 루트 폴더에 배치하세요.
  IIS 필수 모듈: URL Rewrite, FastCGI (PHP)
  ============================================================
-->
<configuration>
  <system.webServer>

    <!-- ─────────────────────────────────────
         PHP 대용량 파일 업로드 지원
         ───────────────────────────────────── -->
    <security>
      <requestFiltering>
        <!-- 10GB 허용 -->
        <requestLimits maxAllowedContentLength="10737418240" />
      </requestFiltering>
    </security>

    <!-- ─────────────────────────────────────
         보안 헤더
         ───────────────────────────────────── -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>

    <!-- ─────────────────────────────────────
         디렉토리 리스팅 비활성화
         ───────────────────────────────────── -->
    <directoryBrowse enabled="false" />

    <!-- ─────────────────────────────────────
         기본 문서
         ───────────────────────────────────── -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- ─────────────────────────────────────
         URL Rewrite 규칙 (보안 + 라우팅)
         ───────────────────────────────────── -->
    <rewrite>
      <rules>

        <!-- [핵심] data/ 폴더: site_images 이미지만 허용 -->
        <rule name="Allow data/site_images" stopProcessing="true">
          <match url="^data/site_images/.*\.(jpg|jpeg|png|gif|webp|svg|ico)$" ignoreCase="true" />
          <action type="None" />
        </rule>
        <rule name="Block data folder" stopProcessing="true">
          <match url="^data/" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- [핵심] api/ 폴더 차단 (include 전용 PHP 클래스) -->
        <rule name="Block api folder" stopProcessing="true">
          <match url="^api/" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- [핵심] users/ 폴더 차단 (사용자 파일) -->
        <rule name="Block users folder" stopProcessing="true">
          <match url="^users/" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- [핵심] shared/ 폴더 차단 (공유 파일) -->
        <rule name="Block shared folder" stopProcessing="true">
          <match url="^shared/" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- [핵심] config.php, lang.php 직접 접근 차단 -->
        <rule name="Block config.php" stopProcessing="true">
          <match url="^config\.php$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>
        <rule name="Block lang.php" stopProcessing="true">
          <match url="^lang\.php$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- 숨김 파일 차단 (.htaccess, .git 등) -->
        <rule name="Block hidden files" stopProcessing="true">
          <match url="(^|/)\." />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- 허용된 PHP만 통과 (화이트리스트) -->
        <rule name="Allow whitelisted PHP" stopProcessing="true">
          <match url="^(index|api|share|hwp_viewer|office_viewer|onlyoffice|mydav)\.php(/.*)?$" ignoreCase="true" />
          <action type="None" />
        </rule>

        <!-- 그 외 PHP 파일 차단 -->
        <rule name="Block other PHP" stopProcessing="true">
          <match url="\.php$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- 기본 라우팅 -->
        <rule name="Default routing" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" appendQueryString="true" />
        </rule>

      </rules>
    </rewrite>

    <!-- ─────────────────────────────────────
         정적 파일 캐싱 (성능)
         ───────────────────────────────────── -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- ─────────────────────────────────────
         api.php PathInfo 지원 (PDF 미리보기 파일명)
         ───────────────────────────────────── -->
    <handlers>
      <!-- PHP FastCGI 핸들러 (경로는 환경에 맞게 수정) -->
      <!--
      <add name="PHP_FastCGI" path="*.php" verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\php\php-cgi.exe"
           resourceType="Either" />
      -->
    </handlers>

  </system.webServer>

  <!-- ─────────────────────────────────────
       하위 폴더별 추가 차단 (이중 보호)
       ───────────────────────────────────── -->
  <location path="data">
    <system.webServer>
      <handlers>
        <!-- data 폴더 내 PHP 실행 차단 -->
        <remove name="PHP_FastCGI" />
      </handlers>
    </system.webServer>
  </location>

  <location path="api">
    <system.webServer>
      <handlers>
        <!-- api 폴더 내 PHP 직접 실행 차단 -->
        <remove name="PHP_FastCGI" />
      </handlers>
    </system.webServer>
  </location>

</configuration>
