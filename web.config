<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  FileStation v5.7.5 - IIS 보안 설정 (web.config)
  ============================================================
  이 파일을 FileStation 루트 폴더에 배치하세요.
  IIS 필수 모듈: URL Rewrite, FastCGI (PHP)
  ============================================================
-->
<configuration>
  <system.webServer>

    <!-- ─────────────────────────────────────
         PHP 대용량 파일 업로드 지원
         ───────────────────────────────────── -->
    <security>
      <requestFiltering>
        <!-- 10GB 허용 -->
        <!-- ★ (2026-10-30 01:54, 26차 점검) IIS 최댓값(uint, 4294967295 ≈ 4GB) — 종전 10GB 값은 형식 범위를 넘어 IIS 가 설정 오류(500.19)로 사이트를 열지 않을 수 있었음. 큰 파일은 조각 업로드로 올라감 -->
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>

    <!-- ─────────────────────────────────────
         보안 헤더
         ───────────────────────────────────── -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>

    <!-- ─────────────────────────────────────
         디렉토리 리스팅 비활성화
         ───────────────────────────────────── -->
    <directoryBrowse enabled="false" />

    <!-- ─────────────────────────────────────
         기본 문서
         ───────────────────────────────────── -->
    <defaultDocument>
      <files>
        <clear />
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- ─────────────────────────────────────
         URL Rewrite 규칙 (보안 + 라우팅)
         ───────────────────────────────────── -->
    <rewrite>
      <rules>

        <!-- [핵심] data/ 폴더: site_images 이미지만 허용 -->
        <rule name="Allow data/site_images" stopProcessing="true">
          <match url="^data/site_images/.*\.(jpg|jpeg|png|gif|webp|svg|ico)$" ignoreCase="true" />
          <action type="None" />
        </rule>
        <rule name="Block data folder" stopProcessing="true">
          <match url="^data/" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- [핵심] api/ 폴더 차단 (include 전용 PHP 클래스) -->
        <rule name="Block api folder" stopProcessing="true">
          <match url="^api/" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- [핵심] users/ 폴더 차단 (사용자 파일) -->
        <rule name="Block users folder" stopProcessing="true">
          <match url="^users/" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- [핵심] shared/ 폴더 차단 (공유 파일) -->
        <rule name="Block shared folder" stopProcessing="true">
          <match url="^shared/" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- [핵심] config.php, lang.php 직접 접근 차단 -->
        <rule name="Block config.php" stopProcessing="true">
          <match url="^config\.php$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>
        <rule name="Block lang.php" stopProcessing="true">
          <match url="^lang\.php$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- 숨김 파일 차단 (.htaccess, .git 등) -->
        <!-- ★ (2026-11-01 09:43, 38차 점검) WebDAV 하위 경로(mydav.php/…)와 인증서 갱신 경로(.well-known/acme-challenge/)는 빼고 검사 — 종전 (^|/)\. 은
             mydav.php/홈/.hidden·macOS 의 ._파일·.DS_Store 를 아래 PHP 허용 목록에 닿기 전에 403 으로 막았고(nginx 는 22차에 고침), Let's Encrypt HTTP-01 갱신도 403 이었음.
             그 밖의 경로는 종전과 같음 -->
        <rule name="Block hidden files" stopProcessing="true">
          <match url="^(?!mydav\.php/|\.well-known/acme-challenge/)(.*/)?\." />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- ★ (2026-11-01 09:43, 38차 점검) 문서·예제 파일(README.md·ONLYOFFICE_SETUP.md·LICENSE·nginx.conf.example) 직접 받기 차단 — 지금은 IIS 에 .md 형식이 없어 우연히 404.3 일 뿐이라
             형식을 추가하면 공개됐음. PHP 뒤 경로(mydav.php/…·api.php/파일이름)의 같은 이름 파일은 막지 않음 -->
        <rule name="Block docs" stopProcessing="true">
          <match url="^(?![^/]*\.php/)(.*/)?([^/]+\.(md|example)|LICENSE)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- 허용된 PHP만 통과 (화이트리스트) -->
        <rule name="Allow whitelisted PHP" stopProcessing="true">
          <!-- ★ (2026-10-29 18:49, 22차 점검) 한글 새 뷰어·편집기(rhwp_viewer·rhwp_editor) 추가 — 종전엔 빠져 IIS 에서는 403 -->
          <match url="^(index|api|share|hwp_viewer|office_viewer|onlyoffice|mydav|rhwp_viewer|rhwp_editor)\.php(/.*)?$" ignoreCase="true" />
          <action type="None" />
        </rule>

        <!-- 그 외 PHP 파일 차단 -->
        <rule name="Block other PHP" stopProcessing="true">
          <match url="\.php$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Access denied" />
        </rule>

        <!-- 기본 라우팅 -->
        <rule name="Default routing" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.php" appendQueryString="true" />
        </rule>

      </rules>
    </rewrite>

    <!-- ─────────────────────────────────────
         정적 파일 캐싱 (성능)
         ───────────────────────────────────── -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      <!-- ★ (2026-10-30 11:30) PDF.js 6 이 읽는 파일 — IIS 는 모르는 확장자를 404.3 으로 막음(이미 있으면 겹침 오류가 나지 않게 remove 먼저) -->
      <remove fileExtension=".bcmap" />
      <mimeMap fileExtension=".bcmap" mimeType="application/octet-stream" />
      <remove fileExtension=".pfb" />
      <mimeMap fileExtension=".pfb" mimeType="application/x-font-type1" />
      <remove fileExtension=".ttf" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".icc" />
      <mimeMap fileExtension=".icc" mimeType="application/vnd.iccprofile" />
      <!-- ★ (2026-10-30 23:36) 로그인 안내 가변 글꼴(assets/fonts/fs-hint-var.woff2)·한글 문서 뷰어 글꼴 — IIS 판에 따라 .woff2 가 없으면 404.3 으로 막힘 -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <!-- ─────────────────────────────────────
         api.php PathInfo 지원 (PDF 미리보기 파일명)
         ───────────────────────────────────── -->
    <handlers>
      <!-- PHP FastCGI 핸들러 (경로는 환경에 맞게 수정) -->
      <!--
      <add name="PHP_FastCGI" path="*.php" verb="*"
           modules="FastCgiModule"
           scriptProcessor="C:\php\php-cgi.exe"
           resourceType="Either" />
      -->
    </handlers>

  </system.webServer>

  <!-- ─────────────────────────────────────
       하위 폴더별 추가 차단 (이중 보호)
       ───────────────────────────────────── -->
  <location path="data">
    <system.webServer>
      <handlers>
        <!-- data 폴더 내 PHP 실행 차단 -->
        <remove name="PHP_FastCGI" />
      </handlers>
    </system.webServer>
  </location>

  <location path="api">
    <system.webServer>
      <handlers>
        <!-- api 폴더 내 PHP 직접 실행 차단 -->
        <remove name="PHP_FastCGI" />
      </handlers>
    </system.webServer>
  </location>

</configuration>
