# ============================================================
# FileStation v5.7.5 - Nginx 보안 설정
# ============================================================
# 사용법: 이 파일을 참고하여 nginx 서버 블록에 적용하세요.
# 예: /etc/nginx/sites-available/filestation.conf
# ============================================================

server {
    listen 80;
    # listen 443 ssl http2;
    server_name your-domain.com;

    root /var/www/filestation;
    index index.php;

    # ─────────────────────────────────────
    # PHP 설정 (대용량 파일 업로드 지원)
    # ─────────────────────────────────────
    client_max_body_size 0;
    client_body_timeout 3600s;
    proxy_read_timeout 3600s;
    fastcgi_read_timeout 3600s;
    fastcgi_send_timeout 3600s;

    # ─────────────────────────────────────
    # 보안 헤더
    # ─────────────────────────────────────
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # ─────────────────────────────────────
    # [핵심] data/ 폴더 차단 (JSON DB 보호)
    # site_images 이미지만 허용, 나머지 전부 차단
    # ─────────────────────────────────────
    location ^~ /data/ {
        # site_images 이미지만 허용
        location ~ ^/data/site_images/.*\.(jpg|jpeg|png|gif|webp|svg|ico)$ {
            allow all;   # ★ (2026-10-29 18:49, 22차 점검) 바깥의 deny all 을 물려받지 않게 — 종전엔 로고·배경 그림도 403
            expires 30d;
            access_log off;
        }
        # 나머지 전부 차단 (JSON, PHP 등)
        deny all;
        return 403;
    }

    # ─────────────────────────────────────
    # [핵심] api/ 폴더 차단 (PHP 클래스 직접 접근 방지)
    # Auth.php, JsonDB.php 등 include 전용 파일
    # ─────────────────────────────────────
    location ^~ /api/ {
        deny all;
        return 403;
    }

    # ─────────────────────────────────────
    # [핵심] users/ 폴더 차단 (사용자 파일 보호)
    # 모든 파일은 api.php를 통해서만 접근
    # ─────────────────────────────────────
    location ^~ /users/ {
        deny all;
        return 403;
    }

    # ─────────────────────────────────────
    # [핵심] shared/ 폴더 차단 (공유 파일 보호)
    # 모든 파일은 api.php를 통해서만 접근
    # ─────────────────────────────────────
    location ^~ /shared/ {
        deny all;
        return 403;
    }

    # ─────────────────────────────────────
    # [핵심] config.php 직접 접근 차단
    # ─────────────────────────────────────
    location = /config.php {
        deny all;
        return 403;
    }

    # ─────────────────────────────────────
    # [핵심] lang.php 직접 접근 차단
    # ─────────────────────────────────────
    location = /lang.php {
        deny all;
        return 403;
    }

    # ─────────────────────────────────────
    # WebDAV 엔드포인트
    # FileStation의 WebDAV는 PHP가 직접 처리합니다.
    # Nginx는 모든 HTTP 메서드(PROPFIND, PUT 등)를 PHP-FPM에 전달하면 됩니다.
    # fastcgi_params에 REQUEST_METHOD가 포함되어 있으면 별도 설정 없이 동작합니다.
    # ─────────────────────────────────────
    # ★ (2026-10-29 18:49, 22차 점검) '/mydav.php/스토리지/폴더' 하위 경로도 받게 — 종전엔 '= /mydav.php' 하나만 받아 하위 경로가 index.php 로 넘어가
    #   윈도우 드라이브 연결 등 WebDAV 가 동작하지 않았음. 정규식 location 은 위에서부터 처음 맞는 것을 쓰므로 숨김 파일·정적 파일 규칙보다 위에 둠
    #   (아래에 두면 WebDAV 의 .jpg·.css·점 파일 요청이 그 규칙으로 가 404·403)
    location ~ ^/mydav\.php(/.*)?$ {
        fastcgi_split_path_info ^(/mydav\.php)(/.*)$;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/mydav.php;
        fastcgi_param SCRIPT_NAME /mydav.php;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        fastcgi_read_timeout 3600s;
        
        # Authorization 헤더 전달 (WebDAV Basic Auth 필수)
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        
        # 대용량 파일 업로드 허용
        client_max_body_size 0;
    }

    # ─────────────────────────────────────
    # 숨김 파일 차단 (.htaccess, .git 등)
    # ─────────────────────────────────────
    location ~ /\. {
        deny all;
        return 403;
    }

    # ─────────────────────────────────────
    # 디렉토리 리스팅 비활성화
    # ─────────────────────────────────────
    autoindex off;

    # ─────────────────────────────────────
    # 정적 파일 캐싱 (성능)
    # ─────────────────────────────────────
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf)$ {
        expires 7d;
        access_log off;
        add_header Cache-Control "public, immutable";
    }

    # ─────────────────────────────────────
    # api.php PathInfo 지원 (PDF 미리보기 파일명)
    # api.php/filename.pdf 패턴
    # ─────────────────────────────────────
    location ~ ^/api\.php(/|$) {
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        # 또는: fastcgi_pass 127.0.0.1:9000;
        fastcgi_param SCRIPT_FILENAME $document_root/api.php;
        fastcgi_param PATH_INFO $fastcgi_path_info;
        include fastcgi_params;
        fastcgi_read_timeout 3600s;
    }

    # ─────────────────────────────────────
    # 허용된 PHP 파일만 실행
    # index.php, api.php, share.php 등
    # ─────────────────────────────────────
    # ★ (2026-10-29 18:49, 22차 점검) 한글 새 뷰어·편집기(rhwp_viewer·rhwp_editor) 추가 — 종전엔 빠져 nginx 에서는 403
    location ~ ^/(index|api|share|hwp_viewer|office_viewer|onlyoffice|mydav|rhwp_viewer|rhwp_editor)\.php$ {
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        # 또는: fastcgi_pass 127.0.0.1:9000;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_read_timeout 3600s;

        # WebDAV Authorization 헤더 전달
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
    }

    # ─────────────────────────────────────
    # 그 외 PHP 파일 실행 차단
    # ─────────────────────────────────────
    location ~ \.php$ {
        deny all;
        return 403;
    }

    # ─────────────────────────────────────
    # 기본 요청 처리
    # ─────────────────────────────────────
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
}
